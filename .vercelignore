# Keep the upload small: excludeFiles in vercel.json trims the function bundle,
# but this controls what is sent to Vercel in the first place.
.git
.venv
venv
.vscode
logs
__pycache__
*.pyc
*.egg-info
.pytest_cache

# Offline data and tooling the deployed app never touches.
artifacts/structures
artifacts/docking
artifacts/dockingx
artifacts/data
artifacts/md
artifacts/*.pkl
artifacts/*.h5
artifacts/*.csv
docking_results
notebook
data_curation_scripts
tests
src/analysis
src/components

# src/bin is NOT excluded: it holds the AutoGrid binary and the GCC runtime
# libraries that build the zinc maps at request time. Neither is pip-installable,
# so leaving them out of the upload breaks docking entirely.
